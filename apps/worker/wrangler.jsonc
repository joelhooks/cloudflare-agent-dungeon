{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-agent-dungeon",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "agentdungeon.ai",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Referee",
        "class_name": "Referee"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Referee"]
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
